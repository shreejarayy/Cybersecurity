# ---- Database ----
# Default is a local SQLite file; for PostgreSQL use e.g.:
# DATABASE_URL=postgresql://argus:argus@postgres:5432/argus
DATABASE_URL=sqlite:///arguspredict.db

# ---- External services ----
NVD_API_KEY=
REDIS_URL=redis://redis:6379/0

# ---- Scan behaviour ----
SCAN_INTERVAL_HOURS=24
PORT_SCAN_THREADS=150
PORT_SCAN_TIMEOUT=1.0
BANNER_TIMEOUT=2.0
TOP_PORTS=1000

# ---- Analytics ----
ANOMALY_THRESHOLD=0.80
RISK_W_CENTRALITY=0.25
RISK_W_EXPOSURE=0.20
RISK_W_RARITY=0.15
RISK_W_PROPAGATION=0.20

# ---- SAFETY: authorisation allow-list ----
# Only these hosts may be scanned. Add a target ONLY if you are legally
# authorised to scan it. scanme.nmap.org is the Nmap Project's public,
# authorised educational target.
AUTHORISED_TARGETS=scanme.nmap.org,127.0.0.1,localhost,google.com,cue.christuniversity.in

# ---- Alerting ----
ALERT_THRESHOLD=9.0
ALERT_WEBHOOK=
TLS_PORTS=443,8443,993,995,465,990